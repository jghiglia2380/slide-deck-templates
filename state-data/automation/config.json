    "KS", "KY", "LA", "MD", "ME", "MI", "MN", "MO", "MS", "NC",
    "NE", "NH", "NJ", "NY", "OH", "OK", "OR", "PA", "RI", "SC",
    "TN", "TX", "UT", "VA", "WI", "WV"
