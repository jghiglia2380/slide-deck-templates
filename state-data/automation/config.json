      "reason": "URLs and agency names rarely change; annual refresh sufficient"
    }
  },
  "data_versioning": {
    "enabled": true,
    "format": "YYYY-QN",
    "current_version": "2025-Q4",
    "changelog_path": "../changelog/",
    "archive_old_versions": true,
    "retention_period_years": 5
  },
  "notifications": {
    "enabled": true,
