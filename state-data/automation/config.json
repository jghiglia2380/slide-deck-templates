      "day_of_month": 1,
      "time": "03:00",
      "timezone": "America/New_York"
    },
    "annual": {
      "enabled": true,
      "description": "Taxes, tuition, DMV fees, URLs, agency names, local examples (includes former 'as-needed')",
      "variable_count": 70,
      "month": 9,
      "day_of_month": 1,
      "time": "04:00",
      "timezone": "America/New_York"
    }
  },
  "deprecated_schedules": {
    "as_needed": {
